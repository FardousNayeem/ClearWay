# --- Application --------------------------------------------------------
CLEARWAY_ENV=local
CLEARWAY_DEBUG=true
CLEARWAY_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
CLEARWAY_DATABASE_URL=postgresql+psycopg://clearway:clearway@127.0.0.1:5436/clearway

# --- Upstream data ------------------------------------------------------
# Ground truth comes from two independent networks. Neither is required: with
# no key at all the app runs in CAMS-only mode, where forecasts still work but
# there is nothing to score them against or train on. Supplying either one
# turns the learning loop on; supplying both improves coverage, which matters
# most in Beijing and Chattogram where OpenAQ alone is thin.
CLEARWAY_OPENAQ_API_KEY=
CLEARWAY_OPENAQ_BASE_URL=https://api.openaq.org/v3
# Free token from https://aqicn.org/data-platform/token/
CLEARWAY_WAQI_API_TOKEN=
CLEARWAY_WAQI_BASE_URL=https://api.waqi.info
CLEARWAY_OPENMETEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
CLEARWAY_OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
CLEARWAY_OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
CLEARWAY_OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
CLEARWAY_OPENMETEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# --- Frontend -----------------------------------------------------------
CLEARWAY_CORS_ORIGINS=http://localhost:3000

# --- Model artefacts ----------------------------------------------------
CLEARWAY_MODEL_DIR=var/models
